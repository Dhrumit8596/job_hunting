#!/usr/bin/env bash
# Pre-commit guard: (1) block PII/secrets in staged content, (2) run the test suite.
# This script is committed and contains NO personal data. Project-specific literal
# tokens (real name, emails, etc.) live in .githooks/pii-extra.local (gitignored).
set -u
fail=0

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# Only scan text files that exist.
scan_files=()
while IFS= read -r f; do
  [ -f "$f" ] || continue
  case "$f" in node_modules/*|.githooks/*) continue;; esac
  scan_files+=("$f")
done <<< "$staged"
[ ${#scan_files[@]} -eq 0 ] && exit 0

report() { echo "  ✗ PII/secret blocked: $1"; fail=1; }

# 1) Generic high-signal secrets/PII (no personal data embedded here).
if git grep --cached -I -nE "data:application/pdf;base64,[A-Za-z0-9+/]{100,}|JVBERi0[A-Za-z0-9+/]{60,}" -- "${scan_files[@]}" >/dev/null 2>&1; then
  git grep --cached -I -nE "data:application/pdf;base64,[A-Za-z0-9+/]{100,}|JVBERi0[A-Za-z0-9+/]{60,}" -- "${scan_files[@]}" | head -5
  report "embedded base64 PDF / resume data"
fi
if git grep --cached -I -nE "-----BEGIN [A-Z ]*PRIVATE KEY-----" -- "${scan_files[@]}" >/dev/null 2>&1; then
  report "private key"
fi

# 2) Project-specific literal tokens from the gitignored extras file (one per line).
extra=".githooks/pii-extra.local"
if [ -f "$extra" ]; then
  while IFS= read -r tok; do
    [ -z "$tok" ] && continue
    case "$tok" in \#*) continue;; esac
    if git grep --cached -I -i -n -F "$tok" -- "${scan_files[@]}" >/dev/null 2>&1; then
      report "matched private token (see $extra)"
    fi
  done < "$extra"
fi

if [ "$fail" -ne 0 ]; then
  echo "Commit aborted: remove the PII/secret above (or move it to a gitignored *.local file)."
  exit 1
fi

# 3) Tests must pass.
if ! npm test --silent; then
  echo "Commit aborted: npm test failed."
  exit 1
fi

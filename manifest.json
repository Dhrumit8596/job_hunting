{
  "manifest_version": 3,
  "name": "Job Application Assistant",
  "version": "1.0.6",
  "description": "AI-powered job search assistant for semiconductor/medtech roles",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "activeTab",
    "tabs",
    "debugger",
    "notifications",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.linkedin.com/in/*",
    "*://*.indeed.com/*",
    "*://*.glassdoor.com/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.workday.com/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.jobvite.com/*",
    "*://*.icims.com/*",
    "*://*.taleo.net/*",
    "*://*.bamboohr.com/*",
    "*://*.smartrecruiters.com/*",
    "*://*.ashbyhq.com/*",
    "*://*.rippling.com/*",
    "*://*.paylocity.com/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/in/*",
        "*://*.linkedin.com/jobs/view/*",
        "*://*.linkedin.com/jobs/collections/*",
        "*://*.linkedin.com/jobs/search-results/*",
        "*://*.linkedin.com/jobs/search/*",
        "*://*.indeed.com/viewjob*",
        "*://*.indeed.com/jobs*",
        "*://smartapply.indeed.com/*",
        "*://profile.indeed.com/*",
        "*://*.glassdoor.com/job-listing/*",
        "*://*.glassdoor.com/Jobs/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.workday.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.jobvite.com/*",
        "*://*.icims.com/*",
        "*://*.taleo.net/*",
        "*://*.bamboohr.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.ashbyhq.com/*",
        "*://*.paylocity.com/*",
        "*://*.successfactors.com/*",
        "*://*.smashfly.com/*",
        "*://*/careers/*",
        "*://*/careers*",
        "*://*/talentcommunity/*",
        "*://*/jobs/*",
        "*://*/job-details/*",
        "*://*/job/*",
        "*://*/apply*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "js": [
        "content/extractors/linkedin.js",
        "content/extractors/indeed.js",
        "content/extractors/glassdoor.js",
        "content/extractors/generic.js",
        "sourcing/detect-ats.js",
        "sourcing/apply-select.js",
        "content/apply-router.js",
        "content/apply-preflight.js",
        "content/apply-account.js",
        "content/autofill.js",
        "content/workday-engine.js",
        "content/workday-auth.js",
        "content/auto-apply.js",
        "content/external-apply.js",
        "browser-batch.js",
        "content/job-scraper.js",
        "content/indeed-scraper.js",
        "content/glassdoor-scraper.js",
        "content/indeed-apply.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "sourcing/detect-ats.js",
        "sourcing/apply-select.js",
        "content/apply-router.js",
        "content/apply-account.js",
        "content/external-apply.js",
        "content/indeed-apply.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "exclude_matches": [
        "*://*.linkedin.com/*",
        "*://indeed.com/*",
        "*://www.indeed.com/*",
        "*://smartapply.indeed.com/*",
        "*://*.glassdoor.com/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/fiber-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false,
      "exclude_matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.glassdoor.com/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ]
    },
    {
      "_comment": "Embedded-ATS iframe support: companies embed the ATS form in a cross-origin iframe (e.g. job-boards.greenhouse.io/embed/job_app inside psiquantum.com/apply). all_frames:true + ATS-host matches injects the fill suite INTO that iframe so external-apply can fill/submit it. Narrow to ATS hosts so it doesn't run in every iframe on the web.",
      "matches": [
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.ashbyhq.com/*",
        "*://*.icims.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.workday.com/*",
        "*://*.jobvite.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.bamboohr.com/*",
        "*://*/talentcommunity/*"
      ],
      "js": [
        "sourcing/detect-ats.js",
        "sourcing/apply-select.js",
        "content/apply-router.js",
        "content/apply-preflight.js",
        "content/apply-account.js",
        "content/autofill.js",
        "content/workday-engine.js",
        "content/workday-auth.js",
        "content/external-apply.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "_comment": "fiber-main (MAIN world) into embedded ATS iframes too, so the react-select fiber bridge works inside the iframe form.",
      "matches": [
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.ashbyhq.com/*",
        "*://*.icims.com/*",
        "*://*.myworkdayjobs.com/*"
      ],
      "js": [
        "content/fiber-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Job Pipeline"
  },
  "options_page": "settings/settings.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "test/*.html",
        "shortlist/shortlist.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
